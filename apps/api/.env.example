NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

DATABASE_URL=postgresql://postgres:Devpostgress4526@@db.cgqovzyzxxsciugukdyi.supabase.co:5432/postgres
DIRECT_URL=
DB_POOL_MAX=10
DB_IDLE_TIMEOUT=20
DB_CONNECT_TIMEOUT=10

MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=./uploads

# Storage backend: local (dev default, no external services) or r2 (prod)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage
LOCAL_STORAGE_SECRET=dev-only-insecure-secret-do-not-use-in-production
LOCAL_STORAGE_PUBLIC_URL=http://localhost:4000

# Only required when STORAGE_DRIVER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=pdf-forge-temp
R2_PUBLIC_URL=
R2_PRESIGN_TTL_SEC=3600

# Job runner: memory (dev default, in-process) or bullmq (prod)
JOB_RUNNER=memory

# Only required when JOB_RUNNER=bullmq OR RATE_LIMIT_BACKEND=redis (Upstash TLS TCP, not REST)
REDIS_URL=
WORKER_CONCURRENCY=4
TEMP_FILE_TTL_MS=3600000

# Tier-aware rate limiter: memory (dev default) or redis (prod)
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_TIER_WINDOW_MS=86400000
UPGRADE_URL=/dashboard/billing

# Clerk (optional in dev, REQUIRED in production)
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
CLERK_JWT_ISSUER=
