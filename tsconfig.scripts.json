{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "noEmit": true,
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true
  },
  "include": ["scripts/**/*.ts", "drizzle.config.ts"],
  "exclude": ["node_modules", "**/dist", "**/.next", "apps", "packages"]
}
