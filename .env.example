# ──────────────────────────────────────────────────────────────────
# PDF Forge — environment variables
#
# Two modes are supported:
#
#   • LOCAL DEV (zero external services — the default)
#       STORAGE_DRIVER=local
#       JOB_RUNNER=memory
#       Files live under ./storage, jobs run via setTimeout in-process.
#       NOTHING in the R2_* or REDIS sections needs to be filled in.
#
#   • PRODUCTION (R2 + Upstash + Supabase)
#       STORAGE_DRIVER=r2
#       JOB_RUNNER=bullmq
#       Fill in the R2 and Redis sections; the env loader refuses to
#       boot in production with the dev defaults.
#
# Copy to `.env` and fill values as appropriate. NEVER commit `.env`.
# ──────────────────────────────────────────────────────────────────

# ─── Shared ───────────────────────────────────────────────────────
NODE_ENV=development

# ─── apps/api ─────────────────────────────────────────────────────
# HTTP server
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# CORS — comma-separated list of allowed origins (used in production).
# Example: https://pdf-forge.app,https://www.pdf-forge.app
CORS_ORIGINS=http://localhost:3000

# Rate limiter
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Database — Postgres (Supabase in production, local docker for dev).
# Local dev with docker:
#   docker run -d --name pdf-forge-pg -p 5432:5432 -e POSTGRES_PASSWORD=postgres postgres:15
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pdf_forge
# Direct (non-pooled) connection — only needed in production with Supabase.
DIRECT_URL=

# Postgres pool sizing (runtime client only)
DB_POOL_MAX=10
DB_IDLE_TIMEOUT=20
DB_CONNECT_TIMEOUT=10

# File upload limits
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=./uploads

# ─── Storage backend ──────────────────────────────────────────────
# `local`: write under LOCAL_STORAGE_DIR; presigned URLs hit our own
#          /api/storage endpoints. ZERO external services. (Dev default.)
# `r2`:    Cloudflare R2. Requires the R2_* vars below. (Required in prod.)
STORAGE_DRIVER=local

# Local driver — only used when STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage
# 32+ char secret used to HMAC-sign presigned URL tokens.
# Defaults to a known dev sentinel; the env loader refuses to boot in
# production with the default value, so override it on every prod deploy.
LOCAL_STORAGE_SECRET=dev-only-insecure-secret-do-not-use-in-production
# Public base URL of the API itself (the local driver builds presigned
# URLs against this). Use http://localhost:4000 for native dev or your
# tunnel URL when testing webhooks.
LOCAL_STORAGE_PUBLIC_URL=http://localhost:4000

# Cloudflare R2 — only used when STORAGE_DRIVER=r2
# Find these in: Cloudflare dashboard → R2 → "Manage R2 API Tokens".
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=pdf-forge-temp
# Optional public CDN base URL (custom domain or r2.dev). Leave blank for
# fully private buckets.
R2_PUBLIC_URL=
R2_PRESIGN_TTL_SEC=3600

# ─── Job runner ───────────────────────────────────────────────────
# `memory`: setTimeout-based, in-process scheduler. Jobs are lost on
#           restart. ZERO external services. (Dev default.)
# `bullmq`: BullMQ + Redis (Upstash). Requires REDIS_URL. (Required in prod.)
JOB_RUNNER=memory

# Redis (Upstash) — only used when JOB_RUNNER=bullmq
# IMPORTANT: BullMQ requires the standard Redis TCP protocol — the Upstash
# REST API (@upstash/redis) is NOT supported. Use the TLS connection string
# from the Upstash dashboard ("Connect to your database" → "TLS/SSL").
# Format: rediss://default:TOKEN@<region>.upstash.io:6379
REDIS_URL=

# Worker tuning
WORKER_CONCURRENCY=4
# Default lifetime of generated output files (1h = 3600000ms)
TEMP_FILE_TTL_MS=3600000

# ─── Tier-aware rate limiter ──────────────────────────────────────
# `memory`: in-process sliding window (single-instance only).  ZERO external
#           services. (Dev default.)
# `redis`:  ioredis-backed sliding window with a Lua script for atomicity.
#           Reuses REDIS_URL above. (Required in prod.)
RATE_LIMIT_BACKEND=memory
# Sliding window for daily quotas (24h = 86400000ms).
RATE_LIMIT_TIER_WINDOW_MS=86400000
# Where to send users when they exceed their tier quota (relative or absolute).
UPGRADE_URL=/dashboard/billing

# ─── Clerk (auth) ─────────────────────────────────────────────────
# Get these from the Clerk dashboard → API Keys.  When BOTH are unset, the
# app boots in "anonymous-only" mode (every visitor gets the strictest quota,
# /dashboard refuses to load, /sign-in renders a configuration error).  This
# keeps the local dev path zero-cost; production refuses to boot without them.
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
# Optional: pin the JWT issuer for extra defence against revoked / misissued
# tokens.  Format: https://<your-app>.clerk.accounts.dev
CLERK_JWT_ISSUER=

# ─── apps/web ─────────────────────────────────────────────────────
# Public URL of the API consumed by the Next.js client
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME=PDF Forge
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk publishable key (safe to ship to the browser).  Required for the
# Next.js middleware + ClerkProvider to mount.  When unset, the web app
# behaves as anonymous-only — useful for the local zero-cost dev mode.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Optional overrides for the hosted Clerk pages (defaults below match our
# (auth) route group).  Adjust if you change the route layout.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard
